    @bone name 'body' move (0,0,0) {
        @box from (-0.075,-0.15,-0.1) to (0.075,0.07,0.08) texture "$plumage"
        @box from (-0.04,-0.22,0.06) to (0.04,-0.12,0.36) texture "$plumage"
                @bone name 'head' move (0,0.06,-0.04) {
            @box from (-0.07,0,-0.1) to (0.07,0.13,0.04) texture "$plumage" {
            @part tags (north) texture "$face" region (0,0,1,1)
        }
            @box from (-0.03,0.02,-0.15) to (0.03,0.09,-0.1) texture "entities/mw_parrot_beak"
            @box from (-0.02,-0.02,-0.15) to (0.02,0.02,-0.11) texture "entities/mw_parrot_beak"
        }
                @bone name 'wing_l' move (-0.078,0.06,-0.08) {
            @box from (-0.02,-0.17,0) to (0,0,0.24) texture "$wing"
        }
                @bone name 'wing_r' move (0.078,0.06,-0.08) {
            @box from (0,-0.17,0) to (0.02,0,0.24) texture "$wing"
        }
                @bone name 'leg_l' move (-0.045,-0.15,0) {
            @box from (-0.012,-0.1,-0.012) to (0.012,0,0.012) texture "entities/mw_bird_leg"
            @box from (-0.035,-0.1,-0.06) to (0.035,-0.085,0.02) texture "entities/mw_bird_leg"
        }
                @bone name 'leg_r' move (0.045,-0.15,0) {
            @box from (-0.012,-0.1,-0.012) to (0.012,0,0.012) texture "entities/mw_bird_leg"
            @box from (-0.035,-0.1,-0.06) to (0.035,-0.085,0.02) texture "entities/mw_bird_leg"
        }
    }
