@bone name 'rotor' {
    @box from (-0.09,-0.5,-0.09) to (0.09,0.5,0.09) texture "blocks:wood" {
        @part tags (top,bottom) texture "blocks:wood_top"
    }
    @box from (-0.27,-0.42,-0.27) to (0.27,-0.36,0.27) texture "blocks:planks"
    @box from (-0.27,-0.42,-0.27) to (0.27,-0.36,0.27) origin (0,0,0) rotate (0,45,0) texture "blocks:planks"
    @box from (-0.27,0.36,-0.27) to (0.27,0.42,0.27) texture "blocks:planks"
    @box from (-0.27,0.36,-0.27) to (0.27,0.42,0.27) origin (0,0,0) rotate (0,45,0) texture "blocks:planks"
    @box from (-0.03,-0.36,0.27) to (0.03,0.36,0.33) texture "blocks:wood"
    @box from (-0.03,-0.36,0.27) to (0.03,0.36,0.33) origin (0,0,0) rotate (0,60,0) texture "blocks:wood"
    @box from (-0.03,-0.36,0.27) to (0.03,0.36,0.33) origin (0,0,0) rotate (0,120,0) texture "blocks:wood"
    @box from (-0.03,-0.36,0.27) to (0.03,0.36,0.33) origin (0,0,0) rotate (0,180,0) texture "blocks:wood"
    @box from (-0.03,-0.36,0.27) to (0.03,0.36,0.33) origin (0,0,0) rotate (0,240,0) texture "blocks:wood"
    @box from (-0.03,-0.36,0.27) to (0.03,0.36,0.33) origin (0,0,0) rotate (0,300,0) texture "blocks:wood"
}
