@bone name 'rotor' {
    @box from (-0.06,-0.5,-0.06) to (0.06,-0.12,0.06) texture "blocks:wood"
    @box from (-0.3,-0.14,-0.3) to (0.3,0.06,0.3) texture "blocks:stone"
    @box from (-0.3,-0.14,-0.3) to (0.3,0.06,0.3) origin (0,0,0) rotate (0,45,0) texture "blocks:stone"
    @box from (-0.06,0.06,-0.06) to (0.06,0.12,0.06) texture "blocks:wood"
    @box from (-0.22,0.05,-0.03) to (0.22,0.1,0.03) texture "blocks:wood"
}
