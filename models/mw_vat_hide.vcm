@bone name 'skin' {
    @box from (-0.12,0,-0.1) to (0.12,0.035,0.1) texture "$skin"
    @box from (-0.09,0.03,-0.06) to (0.08,0.06,0.07) origin (-0.005,0.045,0.005) rotate (0,25,8) texture "$skin"
    @box from (0.02,0,0.06) to (0.14,0.03,0.15) origin (0.08,0.015,0.105) rotate (0,-20,-6) texture "$skin"
}
